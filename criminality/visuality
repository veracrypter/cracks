            local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
            local isRage = RageBotActive and RageTargetPlayer
            local sAimEnabled = Settings.SilentAim.Enabled
            
            if not isRage and not sAimEnabled then return end
            if not gun or not tool or gun ~= tool then return end
            
            local actualTarget = isRage and RageTargetPlayer or SilentAimTarget
            if not actualTarget or not actualTarget.Character then return end
            
            local targetPartName = isRage and Settings.RageBot.HitPart or (Settings.SilentAim.TargetPart == "Random" and Settings.SilentAim.RandomPart or Settings.SilentAim.TargetPart)
            local part = actualTarget.Character:FindFirstChild(targetPartName)
            if not part then return end
            
            if not isRage and Settings.SilentAim.HitChance < 100 and math.random(1, 100) > Settings.SilentAim.HitChance then return end
            
            local hitPos = part.Position
            
            -- Penetration FastCast Redux Logic
            if Settings.Wallbang.Enabled then
                local startPosRay = Camera.CFrame.Position
                local direction = (hitPos - startPosRay).Unit
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
                
                local currentPos = startPosRay
                local remainingDist = (hitPos - startPosRay).Magnitude
                local maxPenetrations = 10
                
                for i = 1, maxPenetrations do
                    local rayResult = workspace:Raycast(currentPos, direction * remainingDist, rayParams)
                    if not rayResult then break end
                    
                    if rayResult.Instance:IsDescendantOf(part.Parent) then
                        hitPos = rayResult.Position
                        break
                       else
                        currentPos = rayResult.Position + direction * 0.1
                        remainingDist = (hitPos - currentPos).Magnitude
                        if not table.find(rayParams.FilterDescendantsInstances, rayResult.Instance) then
                            table.insert(rayParams.FilterDescendantsInstances, rayResult.Instance)
                        end
                    end
                end
            end
            
            local bullets = {}
            local count = type(bulletsPerShot) == "table" and #bulletsPerShot or 1
            for i = 1, math.clamp(count, 1, 100) do
                bullets[i] = CFrame.new(startPos, hitPos).LookVector
            end
            task.wait(0.005)
            for idx, dir in pairs(bullets) do
                pcall(function() dmgEvent:FireServer("🧈", gun, shotCode, idx, part, hitPos, dir) end)
		local hitm = tool:FindFirstChild("Hitmarker")
	        if hitm then hitm:Fire(tchar:FindFirstChild(Settings.RageBot.HitPart)) end
            end
            
            if Settings.Hitsound.Selected ~= "None" and Hitsound.SoundId ~= "" then
                pcall(function() Hitsound:Play() end)
            end
            if Settings.BulletBeam.Enabled then
                local beamData = createBeam(Camera.CFrame.Position, hitPos)
                if beamData then
                    table.insert(VisualityData.ActiveBeams, beamData)
                end
            end
        end)
        table.insert(Connections, conn)
    end
end

function InitAimbot()
    local iB = UserInputService.InputBegan:Connect(function(inp, gp)
        if gp then return end
        if Settings.Aimbot.Key == "MB2" and inp.UserInputType == Enum.UserInputType.MouseButton2 then AimbotActive = true
        elseif Settings.Aimbot.Key == "MB1" and inp.UserInputType == Enum.UserInputType.MouseButton1 then AimbotActive = true end
    end)
    local iE = UserInputService.InputEnded:Connect(function(inp)
        if Settings.Aimbot.Key == "MB2" and inp.UserInputType == Enum.UserInputType.MouseButton2 then AimbotActive = false; AimbotTarget = nil
        elseif Settings.Aimbot.Key == "MB1" and inp.UserInputType == Enum.UserInputType.MouseButton1 then AimbotActive = false; AimbotTarget = nil end
    end)
    local loop = RunService.RenderStepped:Connect(function()
        if not Settings.Aimbot.Enabled or not AimbotActive then AimbotTarget = nil; return end
        if not AimbotTarget or not AimbotTarget.Character or not IsAlive(AimbotTarget) then
            AimbotTarget = GetClosestTarget(Settings.Aimbot.TargetPart, Settings.Aimbot.WallCheck, Settings.Aimbot.TeamCheck, Settings.Aimbot.CheckDowned, Settings.Aimbot.FOVEnabled, Settings.Aimbot.FOVRadius)
        end
        if AimbotTarget and AimbotTarget.Character then
            local part = AimbotTarget.Character:FindFirstChild(Settings.Aimbot.TargetPart)
            if part then
                local hrp = AimbotTarget.Character:FindFirstChild("HumanoidRootPart")
                local velocity = hrp and hrp.AssemblyLinearVelocity or Vector3.new()
                local predictedPos = part.Position + (velocity * Settings.Aimbot.Prediction)
                local cur = Camera.CFrame
                Camera.CFrame = cur:Lerp(CFrame.new(cur.Position, predictedPos), math.clamp(Settings.Aimbot.Smoothness, 0.01, 1))
            end
        end
    end)
    table.insert(Connections, iB)
    table.insert(Connections, iE)
    table.insert(Connections, loop)
end

