function setupSafeESP()
    if VisualityData.SafeESP.Coroutine then return end
    VisualityData.SafeESP.Coroutine = coroutine.create(function()
        while Settings.SafeESP.Enabled do
            local map = Workspace:FindFirstChild("Map")
            local bredMakurz = map and map:FindFirstChild("BredMakurz")
            if bredMakurz then
                for _, safeName in ipairs(VisualityData.SafeESP.Names) do
                    local safe = bredMakurz:FindFirstChild(safeName)
                    if safe then
                        local isBroken = false
                        pcall(function()
                            local values = safe:FindFirstChild("Values")
                            if values then
                                local broken = values:FindFirstChild("Broken")
                                if broken then isBroken = broken.Value end
                            end
                            if not isBroken then
                                local interact = safe:FindFirstChild("Interact")
                                if interact then isBroken = interact:GetAttribute("Broken") or false end
                            end
                            local wasBroken = VisualityData.SafeESP.PreviousStates[safeName] or false
                            if isBroken and not wasBroken then
                                VisualityData.SafeESP.ResetTimers[safeName] = 720
                            end
                            VisualityData.SafeESP.PreviousStates[safeName] = isBroken
                            if isBroken and VisualityData.SafeESP.ResetTimers[safeName] then
                                VisualityData.SafeESP.ResetTimers[safeName] = math.max(VisualityData.SafeESP.ResetTimers[safeName] - 1, 0)
                            else
                                VisualityData.SafeESP.ResetTimers[safeName] = nil
                            end
                        end)
                        local highlight = VisualityData.SafeESP.Highlights[safeName]
                        if highlight then
                            highlight.FillColor = isBroken and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(80, 255, 80)
                            highlight.Enabled = true
                            highlight.Adornee = safe
                        elseif not isBroken then
                            createSafeHighlight(safe, safeName, false)
                        end
                    end
                end
                for _, registerName in ipairs(VisualityData.SafeESP.RegisterNames) do
                    local register = bredMakurz:FindFirstChild(registerName)
                    if register then
                        local isBroken = false
                        pcall(function()
                            local values = register:FindFirstChild("Values")
                            if values then
                                local broken = values:FindFirstChild("Broken")
                                if broken then isBroken = broken.Value end
                            end
                            if not isBroken then
                                local interact = register:FindFirstChild("Interact")
                                if interact then isBroken = interact:GetAttribute("Broken") or false end
                            end
                            local wasBroken = VisualityData.SafeESP.RegisterPreviousStates[registerName] or false
                            if isBroken and not wasBroken then
                                VisualityData.SafeESP.ResetTimers[registerName] = 600
                            end
                            VisualityData.SafeESP.RegisterPreviousStates[registerName] = isBroken
                            if isBroken and VisualityData.SafeESP.ResetTimers[registerName] then
                                VisualityData.SafeESP.ResetTimers[registerName] = math.max(VisualityData.SafeESP.ResetTimers[registerName] - 1, 0)
                            else
                                VisualityData.SafeESP.ResetTimers[registerName] = nil
                            end
                        end)
                        local highlight = VisualityData.SafeESP.RegisterHighlights[registerName]
                        if highlight then
                            highlight.FillColor = isBroken and Color3.fromRGB(255, 80, 80) or Color3.fromRGB(80, 255, 80)
                            highlight.Enabled = true
                            highlight.Adornee = register
                        elseif not isBroken then
                            createSafeHighlight(register, registerName, true)
                        end
                    end
                end
            end
            task.wait(1)
        end
    end)
    coroutine.resume(VisualityData.SafeESP.Coroutine)
end

