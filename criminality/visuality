local FreecamSettings = { Speed = 50, Enabled = false }
local FreecamConnections = {}
local FreecamKeysDown = {}
local FreecamRotating = false

function StartNewFreecam()
    if FreecamSettings.Enabled then return end
    FreecamSettings.Enabled = true
    
    local character = LocalPlayer.Character
    local rootPart = character and character:FindFirstChild("HumanoidRootPart")
    if rootPart then rootPart.Anchored = true end

    function handleInput(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.UserInputState == Enum.UserInputState.Begin then
                FreecamKeysDown[input.KeyCode] = true
            elseif input.UserInputState == Enum.UserInputState.End then
                FreecamKeysDown[input.KeyCode] = nil
            end
        elseif input.UserInputType == Enum.UserInputType.MouseButton2 or input.UserInputType == Enum.UserInputType.Touch then
            if input.UserInputState == Enum.UserInputState.Begin then FreecamRotating = true
            elseif input.UserInputState == Enum.UserInputState.End then FreecamRotating = false end
        end
    end

    local ib = UserInputService.InputBegan:Connect(handleInput)
    local ie = UserInputService.InputEnded:Connect(handleInput)
    table.insert(FreecamConnections, ib)
    table.insert(FreecamConnections, ie)

    local ic = UserInputService.InputChanged:Connect(function(input, gameProcessed)
        if gameProcessed or not FreecamRotating then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Delta
            Camera.CFrame = Camera.CFrame * CFrame.Angles(0, -delta.X * 0.005, 0) * CFrame.Angles(-delta.Y * 0.005, 0, 0)
        end
    end)
    table.insert(FreecamConnections, ic)

    local rs = RunService.RenderStepped:Connect(function(delta)
        if not FreecamSettings.Enabled then return end
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("Humanoid") or char.Humanoid.Health <= 0 then 
            FreecamSettings.Enabled = false
            if Toggles and Toggles.NewFreecamToggle then Toggles.NewFreecamToggle:SetValue(false) end
            return 
        end
        
        local moveVector = Vector3.new(0, 0, 0)
        local camLook = Camera.CFrame.LookVector
        local camRight = Camera.CFrame.RightVector
        
        if FreecamKeysDown[Enum.KeyCode.W] then moveVector = moveVector + camLook end
        if FreecamKeysDown[Enum.KeyCode.S] then moveVector = moveVector - camLook end
        if FreecamKeysDown[Enum.KeyCode.A] then moveVector = moveVector - camRight end
        if FreecamKeysDown[Enum.KeyCode.D] then moveVector = moveVector + camRight end
        if FreecamKeysDown[Enum.KeyCode.E] or FreecamKeysDown[Enum.KeyCode.Space] then moveVector = moveVector + Vector3.new(0, 1, 0) end
        if FreecamKeysDown[Enum.KeyCode.Q] or FreecamKeysDown[Enum.KeyCode.LeftShift] then moveVector = moveVector - Vector3.new(0, 1, 0) end
        
        if moveVector.Magnitude > 0 then
            moveVector = moveVector.Unit * FreecamSettings.Speed
            Camera.CFrame = Camera.CFrame + (moveVector * delta)
        end
    end)
    table.insert(FreecamConnections, rs)
    Camera.CameraType = Enum.CameraType.Scriptable
end

function StopNewFreecam()
    FreecamSettings.Enabled = false
    for _, c in ipairs(FreecamConnections) do c:Disconnect() end
    FreecamConnections = {}
    FreecamKeysDown = {}
    FreecamRotating = false
    Camera.CameraType = Enum.CameraType.Custom
    local char = LocalPlayer.Character
    local rootPart = char and char:FindFirstChild("HumanoidRootPart")
    if rootPart then rootPart.Anchored = false end
end

