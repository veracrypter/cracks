    local success, beamData = pcall(function()
        local beam = Instance.new("Beam")
        local att0 = Instance.new("Attachment")
        local att1 = Instance.new("Attachment")
        local parent = Workspace:FindFirstChild("Terrain") or Workspace
        att0.Position = startPos
        att0.Parent = parent
        att1.Position = endPos
        att1.Parent = parent
        beam.Attachment0 = att0
        beam.Attachment1 = att1
        beam.Color = ColorSequence.new({ColorSequenceKeypoint.new(0, Settings.BulletBeam.Color), ColorSequenceKeypoint.new(1, Settings.BulletBeam.Color)})
        beam.Width0 = Settings.BulletBeam.Thickness
        beam.Width1 = Settings.BulletBeam.Thickness * 0.5
        local texData = VisualityData.BeamTextures[Settings.BulletBeam.Type] or VisualityData.BeamTextures["Classic"]
        if Settings.BulletBeam.Type == "Custom" then
            beam.Texture = Settings.BulletBeam.CustomTexture
        else
            beam.Texture = texData.Tex
        end
        beam.TextureLength = texData.Len or 1
        beam.TextureSpeed = texData.Spd or 1
        beam.TextureMode = texData.Mode or "Wrap"
        beam.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, Settings.BulletBeam.Transparency * 0.5),
            NumberSequenceKeypoint.new(0.5, Settings.BulletBeam.Transparency),
            NumberSequenceKeypoint.new(1, 1)
        })
        beam.FaceCamera = true
        beam.LightEmission = 0.5
        beam.LightInfluence = 0.1
        beam.Parent = parent
        return {Beam = beam, Atts = {att0, att1}, Created = tick()}
    end)
    if not success then return nil end
    return beamData
end

