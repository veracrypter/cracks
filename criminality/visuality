function GetBounds(character)
    local minX, minY = math.huge, math.huge
    local maxX, maxY = -math.huge, -math.huge
    local valid = 0
    local partsToCheck = VisualityData.BodyPartNames
    
    for _, name in ipairs(partsToCheck) do
        local part = character:FindFirstChild(name)
        if part and part:IsA("BasePart") then
            local s, cf = part.Size, part.CFrame
            for _, o in ipairs({
                Vector3.new( s.X/2, s.Y/2, s.Z/2), Vector3.new(-s.X/2, s.Y/2, s.Z/2),
                Vector3.new( s.X/2,-s.Y/2, s.Z/2), Vector3.new(-s.X/2,-s.Y/2, s.Z/2),
                Vector3.new( s.X/2, s.Y/2,-s.Z/2), Vector3.new(-s.X/2, s.Y/2,-s.Z/2),
                Vector3.new( s.X/2,-s.Y/2,-s.Z/2), Vector3.new(-s.X/2,-s.Y/2,-s.Z/2),
            }) do
                local sp, on = Camera:WorldToViewportPoint(cf:PointToWorldSpace(o))
                if on then
                    minX = math.min(minX, sp.X); minY = math.min(minY, sp.Y)
                    maxX = math.max(maxX, sp.X); maxY = math.max(maxY, sp.Y)
                    valid = valid + 1
                end
            end
        end
    end
    
    if valid < 4 then
        local hrp = character:FindFirstChild("HumanoidRootPart")
        if hrp then
            local sp, on = Camera:WorldToViewportPoint(hrp.Position)
            if on then
                minX, minY = sp.X - 15, sp.Y - 35
                maxX, maxY = sp.X + 15, sp.Y + 35
                valid = 4
            end
        end
    end
    
    if valid < 4 then return nil end
    return {
        X=minX, Y=minY,
        W=math.max(maxX-minX,10),
        H=math.max(maxY-minY,20),
        CX=(minX+maxX)/2,
    }
end

function CreatePlayerChams(player)
    if PlayerChamsData[player] then return PlayerChamsData[player] end
    local chams = {}
    for _, partName in ipairs(VisualityData.BodyPartNames) do
        local size = VisualityData.BodyPartSizes[partName]
        local isHead = partName == "Head"
        local chamSet = {}
        for k = 1, 2 do
            local inline = (k == 1)
            local cham
            if isHead then
                local sub = inline and 0.4 or 0.3
                cham = Instance.new("CylinderHandleAdornment")
                cham.CFrame = CFrame.new(Vector3.new(), Vector3.new(0, 1, 0))
                cham.Height = size.Y + 0.4 - sub
                cham.Radius = size.X / 2 - sub
            else
                cham = Instance.new("BoxHandleAdornment")
                cham.Size = size + (inline and Vector3.new(-0.1, -0.1, -0.1) or Vector3.new(0.1, 0.1, 0.1))
            end
            cham.ZIndex = 1
            cham.AlwaysOnTop = inline
            cham.Parent = ChamsGui
            chamSet[k] = cham
        end
        chams[partName] = chamSet
    end
    PlayerChamsData[player] = chams
    return chams
end

function IsFriendly(p)
    return p and Settings.FriendlyList[p.UserId] == true
end

function UpdatePlayerChams(player, character)
    local chams = PlayerChamsData[player]
    if not chams then return end
    
    if IsFriendly(player) then
        for _, set in pairs(chams) do
            set[1].Visible = false
            set[2].Visible = false
        end
        return
    end
    
    if not Settings.PlayersChams.Enabled then
        for _, set in pairs(chams) do
            set[1].Visible = false
            set[2].Visible = false
        end
        return
    end
    
    local visibleColor = Settings.PlayersChams.VisibleColor
    local invisibleColor = Settings.PlayersChams.InvisibleColor
    local glow = Settings.PlayersChams.Glow
    
    for partName, set in pairs(chams) do
        local part = character:FindFirstChild(partName)
        local inline, outline = set[1], set[2]
        
        inline.Adornee = part
        inline.Transparency = Settings.PlayersChams.InvisibleTransparency
        inline.Color3 = invisibleColor
        inline.ZIndex = 1
        inline.AlwaysOnTop = glow or true
        inline.Visible = true
        
        outline.Adornee = part
        outline.Transparency = Settings.PlayersChams.VisibleTransparency
        outline.Color3 = visibleColor
        outline.ZIndex = glow and -1 or 1
        outline.AlwaysOnTop = glow
        outline.Visible = true
    end
end

function UpdateESP()
    for player, drawings in pairs(ESPObjects) do
        if player == LocalPlayer then continue end

        local character = player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")
        local lchar = LocalPlayer.Character
        local lroot = lchar and lchar:FindFirstChild("HumanoidRootPart")
        local dist = lroot and hrp and math.floor((hrp.Position - lroot.Position).Magnitude) or 0

        if character and humanoid and hrp then
            if not PlayerChamsData[player] then CreatePlayerChams(player) end
            
            if Settings.PlayersChams.Enabled and dist <= Settings.ESP.MaxDistance then
                UpdatePlayerChams(player, character)
            else
                if PlayerChamsData[player] then
                    for _, set in pairs(PlayerChamsData[player]) do
                        set[1].Visible = false
                        set[2].Visible = false
                    end
                end
            end
        else
            if PlayerChamsData[player] then
                for _, set in pairs(PlayerChamsData[player]) do
                    set[1].Visible = false
                    set[2].Visible = false
                end
            end
            HideAll(drawings)
            continue
        end

        local isAlive = humanoid.Health > 0 and character.Parent ~= nil
        if not isAlive then
            HideAll(drawings)
            continue
        end

        if not Settings.ESP.Enabled then
            HideAll(drawings)
            continue
        end

        if dist > Settings.ESP.MaxDistance then
            HideAll(drawings)
            continue
        end

        local screenPos, onScreen = Camera:WorldToViewportPoint(hrp.Position)
        if not onScreen or screenPos.Z <= 0.1 then
            HideAll(drawings)
            continue
        end

        local b = GetBounds(character)
        if not b then
            HideAll(drawings)
            continue
        end

        local bx, by, bw, bh, cx = b.X, b.Y, b.W, b.H, b.CX
        local isFriendly = IsFriendly(player)
        local espColor = isFriendly and Color3.fromRGB(0, 255, 0) or Settings.ESP.Color
        local sizeMult = Settings.ESP.Size
        
        local healthPct = (humanoid.MaxHealth > 0) and math.clamp(humanoid.Health / humanoid.MaxHealth, 0, 1) or 1

        if Settings.ESP.Box.Enabled then
            drawings.BoxOutline.Size = Vector2.new(bw, bh)
            drawings.BoxOutline.Position = Vector2.new(bx, by)
