            ClearESP(player)
        end
        ClearWorldESP()
        for _, h in pairs(VisualityData.SafeESP.Highlights) do pcall(function() h:Destroy() end) end
        for _, h in pairs(VisualityData.SafeESP.RegisterHighlights) do pcall(function() h:Destroy() end) end
        if VisualityData.Skybox.Current then VisualityData.Skybox.Current:Destroy() end
        if VisualityData.Skybox.Original then VisualityData.Skybox.Original:Clone().Parent = Lighting end
        
        if OriginalAmbiance then
            Lighting.ClockTime = OriginalAmbiance.ClockTime
            Lighting.Brightness = OriginalAmbiance.Brightness
            Lighting.Ambient = OriginalAmbiance.Ambient
            Lighting.OutdoorAmbient = OriginalAmbiance.OutdoorAmbient
            Lighting.ExposureCompensation = OriginalAmbiance.ExposureCompensation or 0
            Lighting.ShadowSoftness = OriginalAmbiance.ShadowSoftness or 0.5
        end
        if BloomEffect then BloomEffect.Enabled = false end
        
        Library:Unload()
    end })

    InitSilentAim()
    InitAimbot()
    
    return Window, UITab
end

