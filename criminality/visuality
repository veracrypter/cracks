local InstantReloadCharConn = nil
local InstantReloadToolConns = {}
function SetInstantReload(v)
    Settings.InstantReload.Enabled = v
    if InstantReloadCharConn then InstantReloadCharConn:Disconnect(); InstantReloadCharConn = nil end
    for _, c in pairs(InstantReloadToolConns) do pcall(function() c:Disconnect() end) end
    InstantReloadToolConns = {}
    if not v then return end

    function setupTool(tool)
        if not tool or not tool:FindFirstChild("IsGun") then return end
        local values = tool:FindFirstChild("Values")
        if not values then return end
        local serverAmmo = values:FindFirstChild("SERVER_Ammo")
        local storedAmmo = values:FindFirstChild("SERVER_StoredAmmo")
        local gunR_remote = ReplicatedStorage:FindFirstChild("Events") and ReplicatedStorage.Events:FindFirstChild("GNX_R")

        if storedAmmo and gunR_remote then
            local conn1 = storedAmmo:GetPropertyChangedSignal("Value"):Connect(function()
                if Settings.InstantReload.Enabled and storedAmmo.Value ~= 0 then
                    pcall(function() gunR_remote:FireServer(tick(), "KLWE89U0", tool) end)
                end
            end)
            table.insert(InstantReloadToolConns, conn1)
        end
        if serverAmmo and gunR_remote then
            local conn2 = serverAmmo:GetPropertyChangedSignal("Value"):Connect(function()
                if Settings.InstantReload.Enabled and storedAmmo and storedAmmo.Value ~= 0 then
                    pcall(function() gunR_remote:FireServer(tick(), "KLWE89U0", tool) end)
                end
            end)
            table.insert(InstantReloadToolConns, conn2)
        end
    end

    function setupCharacter(char)
        for _, c in pairs(InstantReloadToolConns) do pcall(function() c:Disconnect() end) end
        InstantReloadToolConns = {}
        local tool = char:FindFirstChildOfClass("Tool")
        if tool then setupTool(tool) end
        local childAddedConn = char.ChildAdded:Connect(function(obj)
            if obj:IsA("Tool") and obj:FindFirstChild("IsGun") then setupTool(obj) end
        end)
        table.insert(InstantReloadToolConns, childAddedConn)
    end

    if LocalPlayer.Character then setupCharacter(LocalPlayer.Character) end
    InstantReloadCharConn = LocalPlayer.CharacterAdded:Connect(function(char) setupCharacter(char) end)
    
    task.spawn(function()
        local char = LocalPlayer.Character
        if char then
            local tool = char:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("IsGun") then
                local humanoid = char:FindFirstChildOfClass("Humanoid")
                if humanoid then
                    humanoid:UnequipTools()
                    task.wait(0.1)
                    humanoid:EquipTool(tool)
                end
            end
        end
    end)
end

local RageBotConn = nil
local RageBotCamConn = nil
local RageBotOldInstantReload = false
local RageBotOriginalCF = nil

function StopRageBot(silent)
    if not RageBotActive then return end
    RageBotActive = false
    RageTargetPlayer = nil
    if RageBotConn then RageBotConn:Disconnect() RageBotConn = nil end
    if RageBotCamConn then RageBotCamConn:Disconnect() RageBotCamConn = nil end
    
    local curChar = LocalPlayer.Character
    local curRoot = curChar and curChar:FindFirstChild("HumanoidRootPart")
    if curRoot and RageBotOriginalCF then
        curRoot.CFrame = RageBotOriginalCF
        curRoot.Velocity = Vector3.new(0,0,0)
    end

    SetInstantReload(RageBotOldInstantReload)
    Settings.InstantReload.Enabled = RageBotOldInstantReload
    if not silent then
        Library:Notify({Title="Rage Bot", Description="Stopped. Returned to original position.", Time=3})
    end
end

function StartRageBot()
    if RageBotActive then return end
    local targetName = Settings.RageBot.Target
    local targetPlayer = Players:FindFirstChild(targetName)
    if not targetPlayer then
        Library:Notify({Title="Rage Bot", Description="Select a valid player first!", Time=3})
        return
    end

    local lchar = LocalPlayer.Character
    local lroot = lchar and lchar:FindFirstChild("HumanoidRootPart")
    local lhum = lchar and lchar:FindFirstChildOfClass("Humanoid")
    if not lroot or not lhum or lhum.Health <= 0 then return end

    RageBotOriginalCF = lroot.CFrame
    RageBotOldInstantReload = Settings.InstantReload.Enabled
    
    SetInstantReload(true)
    Settings.InstantReload.Enabled = true

    RageBotActive = true
    RageTargetPlayer = targetPlayer
    local LastRageShot = 0

    RageBotConn = RunService.Heartbeat:Connect(function()
        if not RageBotActive then return end

        local tchar = targetPlayer.Character
        local thum = tchar and tchar:FindFirstChildOfClass("Humanoid")
        local troot = tchar and tchar:FindFirstChild("HumanoidRootPart")
        local tpart = tchar and tchar:FindFirstChild(Settings.RageBot.HitPart)

        if not tchar or not thum or not troot or not tpart or thum.Health <= 0 then
            Library:Notify({Title="Rage Bot", Description="Target eliminated. Returned to original position.", Time=3})
            StopRageBot(true)
            return
        end

        local curChar = LocalPlayer.Character
        local curRoot = curChar and curChar:FindFirstChild("HumanoidRootPart")
        local curHum = curChar and curChar:FindFirstChildOfClass("Humanoid")
        
        if not curRoot or not curHum or curHum.Health <= 0 then
            StopRageBot(true)
            return
        end

        local abovePos = troot.Position + Vector3.new(0, 15, 0)
        curRoot.CFrame = CFrame.new(abovePos, tpart.Position)
        curRoot.Velocity = Vector3.new(0,0,0)
        curRoot.AssemblyAngularVelocity = Vector3.new(0,0,0)

        if tick() - LastRageShot >= 0.05 then
            LastRageShot = tick()
            local tool = curChar:FindFirstChildOfClass("Tool")
            if tool and tool:FindFirstChild("IsGun") then
                local hitPos = tpart.Position
                local hitDir = (hitPos - Camera.CFrame.Position).Unit
                local rKey = randStr(30) .. "0"
                pcall(function() GNX:FireServer(tick(), rKey, tool, "FDS9I83", Camera.CFrame.Position, {hitDir}, false) end)
                pcall(function() ZFK:FireServer("🧈", tool, rKey, 1, tpart, hitPos, hitDir, nil, nil) end)

		local hitm = tool:FindFirstChild("Hitmarker")
	        if hitm then hitm:Fire(tchar:FindFirstChild(Settings.RageBot.HitPart)) end
                
                if Settings.Hitsound.Selected ~= "None" and Hitsound.SoundId ~= "" then
                    pcall(function() Hitsound:Play() end)
                end
                if Settings.BulletBeam.Enabled then
                    local beamData = createBeam(Camera.CFrame.Position, hitPos)
                    if beamData then table.insert(VisualityData.ActiveBeams, beamData) end
                end
            end
        end
    end)
    
    RageBotCamConn = RunService.RenderStepped:Connect(function()
        if not RageBotActive then return end
        if targetPlayer and targetPlayer.Character then
            local tpart = targetPlayer.Character:FindFirstChild(Settings.RageBot.HitPart)
            local troot = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
            if tpart and troot then
                local abovePos = troot.Position + Vector3.new(0, 15, 0)
                Camera.CFrame = CFrame.new(abovePos, tpart.Position)
            end
        end
    end)
    
    Library:Notify({Title="Rage Bot", Description="Started! Attacking "..targetName, Time=3})
end

-- Интегрированная логика Bullet Beam (только для LocalPlayer)
function setupBulletBeam()
    if not Settings.BulletBeam.Enabled then return end
    local ev = ReplicatedStorage:FindFirstChild("Events")
    if not ev then return end
    local fireEvent = ev:FindFirstChild("GNX_S")
    if fireEvent then
        local conn = fireEvent.OnClientEvent:Connect(function(st, sc, gun, ft, startPos, dirs, silenced)
            if not Settings.BulletBeam.Enabled then return end
            local character = LocalPlayer.Character
            if not character then return end
            local tool = character:FindFirstChildOfClass("Tool")
            -- Если пушка не наша - скипаем
            if tool ~= gun then return end
            
            local startBeamPos = Camera.CFrame.Position
            for _, dir in pairs(dirs) do
                local ray = Ray.new(startBeamPos, dir * 1000)
                local hit, hitPos = Workspace:FindPartOnRayWithIgnoreList(ray, {Camera, character, gun})
                local endPos = hit and hitPos or (startBeamPos + (dir * 500))
                local beamData = createBeam(startBeamPos, endPos)
                if beamData then
                    table.insert(VisualityData.ActiveBeams, beamData)
                end
            end
        end)
        table.insert(VisualityData.BulletBeamConnections, conn)
    end

    task.spawn(function()
        while Settings.BulletBeam.Enabled do
            task.wait(1)
            local now = tick()
            for i = #VisualityData.ActiveBeams, 1, -1 do
                local data = VisualityData.ActiveBeams[i]
                if now - data.Created > Settings.BulletBeam.Lifetime then
                    pcall(function()
                        if data.Beam then data.Beam:Destroy() end
                        if data.Atts then
                            for _, att in ipairs(data.Atts) do
                                if att then att:Destroy() end
                            end
                        end
                    end)
                    table.remove(VisualityData.ActiveBeams, i)
                end
            end
        end
    end)
end

function toggleBulletBeam(state)
    Settings.BulletBeam.Enabled = state
    if state then
        clearBeams()
        for _, conn in ipairs(VisualityData.BulletBeamConnections) do
            if conn then conn:Disconnect() end
        end
        VisualityData.BulletBeamConnections = {}
        setupBulletBeam()
        local charConn = LocalPlayer.CharacterAdded:Connect(function()
            if not Settings.BulletBeam.Enabled then return end
            clearBeams()
            task.wait(1)
            setupBulletBeam()
        end)
        table.insert(VisualityData.BulletBeamConnections, charConn)
    else
        clearBeams()
        for _, conn in ipairs(VisualityData.BulletBeamConnections) do
            if conn then conn:Disconnect() end
        end
        VisualityData.BulletBeamConnections = {}
    end
end

-- RageBot V2 (Улучшенная логика FOV и привязка к мышке)
local RageBotV2Conn = nil
local RageBotV2OldInstantReload = false

function GetClosestToMouseRageV2()
    local closest = nil
    local shortestDist = Settings.RageBotV2.FOV
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer or IsFriendly(plr) then continue end
        if not IsAlive(plr) then continue end
        if HasFF(plr) then continue end
        local c = GetChar(plr)
        local hum = c and c:FindFirstChildOfClass("Humanoid")
        if not hum or hum.Health <= 0 then continue end
        
        local partsToCheck = {"Head", "HumanoidRootPart", "Torso"}
        local bestPart = nil
        local bestDist = math.huge
        
        for _, partName in ipairs(partsToCheck) do
            local part = c:FindFirstChild(partName)
            if part then
                local sp, onScreen = Camera:WorldToViewportPoint(part.Position)
                if onScreen then
                    -- MouseViewportPos вычисляется в RenderStepped и идеально совпадает с центром круга
                    local dist = (Vector2.new(sp.X, sp.Y) - MouseViewportPos).Magnitude
                    if dist < bestDist then
                        bestDist = dist
                        bestPart = part
                    end
                end
            end
        end
        
        if bestPart and bestDist < shortestDist then
            shortestDist = bestDist
            closest = plr
        end
    end
    return closest
end

function StartRageBotV2()
    if Settings.RageBotV2.Enabled then return end
    Settings.RageBotV2.Enabled = true
    
    if Settings.RageBotV2.UseInstantReload then
        RageBotV2OldInstantReload = Settings.InstantReload.Enabled
        SetInstantReload(true)
    end

    local LastRageV2Shot = 0
    RageBotV2Conn = RunService.Heartbeat:Connect(function()
        local target = GetClosestToMouseRageV2()

        if target and target.Character then
            local hum = target.Character:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local targetPart = target.Character:FindFirstChild("Head") or target.Character:FindFirstChild("HumanoidRootPart")
                local tool = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Tool")
                
                if targetPart and tool and tool:FindFirstChild("IsGun") then
                    if tick() - LastRageV2Shot >= 0.05 then
                        LastRageV2Shot = tick()
                        local hitPos = targetPart.Position
                        local hitDir = (hitPos - Camera.CFrame.Position).Unit
                        
                        if Settings.RageBotV2.UseWallbang then
                            local startPos = Camera.CFrame.Position
                            local direction = (hitPos - startPos).Unit
                            local rayParams = RaycastParams.new()
                            rayParams.FilterType = Enum.RaycastFilterType.Blacklist
                            rayParams.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
                            
                            local currentPos = startPos
                            local remainingDist = (hitPos - startPos).Magnitude
                            local maxPenetrations = 10
                            
                            for i = 1, maxPenetrations do
                                local rayResult = workspace:Raycast(currentPos, direction * remainingDist, rayParams)
                                if not rayResult then break end
                                
                                if rayResult.Instance:IsDescendantOf(targetPart.Parent) then
                                    hitPos = rayResult.Position
                                    break
                                else
                                    currentPos = rayResult.Position + direction * 0.1
                                    remainingDist = (hitPos - currentPos).Magnitude
                                    if not table.find(rayParams.FilterDescendantsInstances, rayResult.Instance) then
                                        table.insert(rayParams.FilterDescendantsInstances, rayResult.Instance)
                                    end
                                end
                            end
                            hitDir = (hitPos - startPos).Unit
                        end

                        local rKey = randStr(30) .. "0"
                        pcall(function() GNX:FireServer(tick(), rKey, tool, "FDS9I83", Camera.CFrame.Position, {hitDir}, false) end)
                        pcall(function() ZFK:FireServer("🧈", tool, rKey, 1, targetPart, hitPos, hitDir, nil, nil) end)
                        
                        if Settings.Hitsound.Selected ~= "None" and Hitsound.SoundId ~= "" then
                            pcall(function() Hitsound:Play() end)
                        end
                        
                        if Settings.BulletBeam.Enabled then
                            local muzzle = findMuzzle(tool)
                            local muzzlePos = muzzle and muzzle.Position or Camera.CFrame.Position
                            local beamData = createBeam(muzzlePos, hitPos)
                            if beamData then
                                table.insert(VisualityData.ActiveBeams, beamData)
                            end
                        end
                    end
                end
            end
        end
    end)
end

function StopRageBotV2()
    Settings.RageBotV2.Enabled = false
    RageBotV2Circle.Visible = false
    if RageBotV2Conn then RageBotV2Conn:Disconnect() RageBotV2Conn = nil end
    
    if Settings.RageBotV2.UseInstantReload then
        SetInstantReload(RageBotV2OldInstantReload)
        Settings.InstantReload.Enabled = RageBotV2OldInstantReload
    end
end

-- C4 & Rocket Control Logic
local ProjectileForward = 0
local ProjectileSideways = 0
local ProjectileBreak = false

function SetupProjectileControl()
    local DebrisFolder = workspace:WaitForChild("Debris")
    local VParts = DebrisFolder:WaitForChild("VParts")

    UserInputService.InputBegan:Connect(function(Key)
        if Key.KeyCode == Enum.KeyCode.W then ProjectileForward = 1
        elseif Key.KeyCode == Enum.KeyCode.S then ProjectileForward = -1
        elseif Key.KeyCode == Enum.KeyCode.D then ProjectileSideways = 1
        elseif Key.KeyCode == Enum.KeyCode.A then ProjectileSideways = -1 end
    end)

    UserInputService.InputEnded:Connect(function(Key)
        if Key.KeyCode == Enum.KeyCode.W or Key.KeyCode == Enum.KeyCode.S then ProjectileForward = 0
        elseif Key.KeyCode == Enum.KeyCode.D or Key.KeyCode == Enum.KeyCode.A then ProjectileSideways = 0 end
    end)

    VParts.ChildAdded:Connect(function(Projectile)
        task.wait()
        if not LocalPlayer.Character then return end

        local isC4 = Projectile.Name == "TransIgnore" and LocalPlayer.Character:FindFirstChild("C4")
        local isRocket = (Projectile.Name == "RPG_Rocket" and LocalPlayer.Character:FindFirstChild("RPG-7")) or 
                         (Projectile.Name == "GrenadeLauncherGrenade" and (LocalPlayer.Character:FindFirstChild("M320-1") or LocalPlayer.Character:FindFirstChild("SCAR-H-X")))

        if Settings.C4Control.Enabled and isC4 then
            -- Продолжаем
        elseif Settings.RocketControl.Enabled and isRocket then
            -- Продолжаем
        else
            return
        end

        Camera.CameraSubject = Projectile
        local root = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if root then root.Anchored = true end

        pcall(function()
            if Projectile:FindFirstChild("BodyForce") then Projectile.BodyForce:Destroy() end
            if Projectile:FindFirstChild("BodyAngularVelocity") then Projectile.BodyAngularVelocity:Destroy() end
            if Projectile:FindFirstChild("Sound") then Projectile.Sound:Destroy() end
            if Projectile.Name == "RPG_Rocket" and Projectile:FindFirstChild("RotPart") and Projectile.RotPart:FindFirstChild("BodyAngularVelocity") then
                Projectile.RotPart.BodyAngularVelocity:Destroy()
            end
        end)

        local BV = Instance.new("BodyVelocity")
        BV.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        BV.Velocity = Vector3.new()
        BV.Parent = Projectile

        local BG = Instance.new("BodyGyro")
        BG.P = 9e4
        BG.MaxTorque = Vector3.new(1e9, 1e9, 1e9)
        BG.Parent = Projectile

        task.spawn(function()
            while Projectile and Projectile.Parent and (Settings.C4Control.Enabled or Settings.RocketControl.Enabled) do
                RunService.RenderStepped:Wait()
                local currentSpeed = Settings.C4Control.Enabled and Settings.C4Control.Speed or Settings.RocketControl.Speed
                BV.Velocity = ((Camera.CFrame.LookVector * ProjectileForward) + (Camera.CFrame.RightVector * ProjectileSideways)) * currentSpeed
                BG.CFrame = Camera.CoordinateFrame
                local targetCFrame = Projectile.CFrame * CFrame.new(0, 1, 1)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame + Vector3.new(0, 5, 0), 0.1)
                if ProjectileBreak then
                    ProjectileBreak = false
                    break
                end
            end
            if LocalPlayer.Character then
                Camera.CameraSubject = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
                local r = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
                if r then r.Anchored = false end
            end
        end)
    end)

    DebrisFolder.ChildAdded:Connect(function(Result)
        task.wait()
        if not LocalPlayer.Character then return end
        pcall(function()
            if LocalPlayer.Character:FindFirstChild("C4") and Result.Name == "C4Explosion" then
                ProjectileBreak = true
                task.wait(1)
                ProjectileBreak = false
            end
            if LocalPlayer.Character:FindFirstChild("RPG-7") and (Result.Name == "RPG_Explosion_Long" or Result.Name == "RPG_Explosion_Short") then
                ProjectileBreak = true
                task.wait(1)
                ProjectileBreak = false
            end
            if (LocalPlayer.Character:FindFirstChild("M320-1") or LocalPlayer.Character:FindFirstChild("SCAR-H-X")) and (Result.Name == "GL_Explosion_Long" or Result.Name == "GL_Explosion_Short") then
                ProjectileBreak = true
                task.wait(1)
                ProjectileBreak = false
            end
        end)
    end)
