local OldSpringAccelerate = nil
function SetCustomRecoil(v)
    Settings.CustomRecoil.Enabled = v
    if not PhysicsModule or not PhysicsModule.spring then return end
    
    if v and not OldSpringAccelerate then
        if PhysicsModule.spring.accelerate then
            OldSpringAccelerate = PhysicsModule.spring.accelerate
            PhysicsModule.spring.accelerate = function(self, impulse, ...)
                if Settings.CustomRecoil.Enabled then
                    local scale = Settings.CustomRecoil.Scale / 100
                    impulse = Vector3.new(impulse.X * scale, impulse.Y * scale, impulse.Z * scale)
                end
                return OldSpringAccelerate(self, impulse, ...)
            end
        else
            OldSpringAccelerate = PhysicsModule.spring.new
            PhysicsModule.spring.new = function(...)
                local spring = OldSpringAccelerate(...)
                local OldAcc = spring.accelerate
                spring.accelerate = function(self, impulse)
                    if Settings.CustomRecoil.Enabled then
                        local scale = Settings.CustomRecoil.Scale / 100
                        impulse = Vector3.new(impulse.X * scale, impulse.Y * scale, impulse.Z * scale)
                    end
                    return OldAcc(self, impulse)
                end
                return spring
            end
        end
    elseif not v and OldSpringAccelerate then
        if PhysicsModule.spring.accelerate then
            PhysicsModule.spring.accelerate = OldSpringAccelerate
        else
            PhysicsModule.spring.new = OldSpringAccelerate
        end
        OldSpringAccelerate = nil
    end
end

