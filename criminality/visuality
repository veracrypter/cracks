function loadModel(typeName)
    local modelData = VisualityData.CustomModels.Models[typeName]
    if not modelData then return false end
    local storage = ReplicatedStorage:FindFirstChild("Storage")
    if not storage then return false end
    local names = {
        ["M4:Subzero"] = "m4a1_subzero",
        ["M4:Dragon"] = "m4a1_c_sm",
        ["MP7:Cryogen"] = "mp7_cryogen",
        ["M4:Heritage"] = "m4a1_heritage",
        ["M4:OPM"] = "m4a1_opm",
        ["Magnum:Showdown"] = "magnum_ind",
        ["Sawn-Off:Eros"] = "sawnoff_eros"
    }
    local searchName = names[typeName] or typeName
    for _, child in ipairs(storage:GetChildren()) do
        if string.lower(child.Name) == searchName then
            modelData.model = child:Clone()
            modelData.loaded = true
            for _, part in ipairs(modelData.model:GetDescendants()) do
                if part:IsA("BasePart") or part:IsA("MeshPart") then
                    part.CanCollide = false
                    part.Massless = true
                    part.CastShadow = false
                    part.CanQuery = false
                end
            end
            return true
        end
    end
    return false
end

function applyCustomModel(weapon, typeName)
    local modelData = VisualityData.CustomModels.Models[typeName]
    if not modelData or not modelData.loaded or not modelData.model then return false end
    if modelData.currentSkin then
        pcall(function() modelData.currentSkin:Destroy() end)
        modelData.currentSkin = nil
    end
    for _, part in ipairs(weapon:GetDescendants()) do
        if (part:IsA("BasePart") or part:IsA("MeshPart")) and part.Transparency < 1 then
            part.Transparency = 1
        end
    end
    local handle = weapon:FindFirstChild("Handle") or weapon:FindFirstChildWhichIsA("BasePart")
    if not handle then return false end
    local skinClone = modelData.model:Clone()
    local primaryPart = skinClone.PrimaryPart
    if not primaryPart then
        primaryPart = skinClone:FindFirstChildWhichIsA("BasePart")
    end
    if not primaryPart then
        skinClone:Destroy()
        return false
    end
    local texId = VisualityData.CustomModels.Textures[typeName]
    for _, part in ipairs(skinClone:GetDescendants()) do
        if part:IsA("MeshPart") then
            part.TextureID = texId
        end
        if part:IsA("BasePart") then
            part.CanCollide = false
            part.Massless = true
            part.CastShadow = false
            part.CanQuery = false
        end
    end
    primaryPart.CFrame = handle.CFrame
    local weld = Instance.new("Weld")
    weld.Part0 = handle
    weld.Part1 = primaryPart
    weld.C0 = CFrame.new()
    weld.C1 = CFrame.new()
    weld.Parent = primaryPart
    skinClone.Parent = weapon
    modelData.currentSkin = skinClone
    modelData.lastWeapon = weapon
    return true
end

function removeCustomModel(typeName)
    local modelData = VisualityData.CustomModels.Models[typeName]
    if not modelData then return end
    if modelData.currentSkin then
        pcall(function() modelData.currentSkin:Destroy() end)
        modelData.currentSkin = nil
    end
    if modelData.lastWeapon then
        for _, part in ipairs(modelData.lastWeapon:GetDescendants()) do
            if (part:IsA("BasePart") or part:IsA("MeshPart")) and part.Transparency == 1 then
                part.Transparency = 0
            end
        end
    end
    modelData.lastWeapon = nil
end

function getCurrentWeapon()
    local character = LocalPlayer.Character
    if not character then return nil end
    for _, child in ipairs(character:GetChildren()) do
        if child:IsA("Tool") then
            return child
        end
    end
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid then
        return humanoid:GetEquippedTool()
    end
    return nil
end

function checkCustomModel()
    if not VisualityData.CustomModels.Enabled then return end
    local weapon = getCurrentWeapon()
    if not weapon then
        removeCustomModel(VisualityData.CustomModels.CurrentModel)
        return
    end
    local modelData = VisualityData.CustomModels.Models[VisualityData.CustomModels.CurrentModel]
    if not modelData then return end
    if weapon ~= modelData.lastWeapon then
        removeCustomModel(VisualityData.CustomModels.CurrentModel)
        task.wait(0.1)
        applyCustomModel(weapon, VisualityData.CustomModels.CurrentModel)
    end
end

function toggleCustomModels(state, modelType)
    VisualityData.CustomModels.Enabled = state
    if modelType then VisualityData.CustomModels.CurrentModel = modelType end
    if state then
        if not VisualityData.CustomModels.Models[VisualityData.CustomModels.CurrentModel].loaded then
            loadModel(VisualityData.CustomModels.CurrentModel)
        end
        if not VisualityData.CustomModels.Models[VisualityData.CustomModels.CurrentModel].loaded then return end
        if VisualityData.CustomModels.HeartbeatConnection then
            VisualityData.CustomModels.HeartbeatConnection:Disconnect()
        end
        VisualityData.CustomModels.HeartbeatConnection = RunService.Heartbeat:Connect(function()
            pcall(checkCustomModel)
        end)
        local charConn = LocalPlayer.CharacterAdded:Connect(function()
            task.wait(1.5)
            removeCustomModel(VisualityData.CustomModels.CurrentModel)
            pcall(checkCustomModel)
        end)
        table.insert(VisualityData.CustomModels.Connections, charConn)
    else
        if VisualityData.CustomModels.HeartbeatConnection then
            VisualityData.CustomModels.HeartbeatConnection:Disconnect()
            VisualityData.CustomModels.HeartbeatConnection = nil
        end
        for _, conn in ipairs(VisualityData.CustomModels.Connections) do
            conn:Disconnect()
        end
        VisualityData.CustomModels.Connections = {}
        removeCustomModel(VisualityData.CustomModels.CurrentModel)
    end
end

function isStaff(player)
    if not player or not player:IsA("Player") then return false end
    for groupId, roles in pairs(VisualityData.AdminCheck.Staff.groups) do
        local success, rank = pcall(function()
            return player:GetRankInGroup(groupId)
        end)
        if success and rank and rank > 0 then
            local success2, role = pcall(function()
                return player:GetRoleInGroup(groupId)
            end)
            if success2 and role and roles[role] then
                return true
            end
        end
    end
    for _, userId in ipairs(VisualityData.AdminCheck.Staff.users) do
        if player.UserId == userId then
            return true
        end
    end
    return false
end

function checkAdmins()
    if not Settings.AdminCheck.Enabled then return end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and isStaff(player) then
            LocalPlayer:Kick("Admin detected: " .. player.Name .. "\nSecurity violation")
            return true
        end
    end
    return false
end

function toggleAdminCheck(state)
    Settings.AdminCheck.Enabled = state
    if state then
        for _, conn in ipairs(VisualityData.AdminCheck.Connections) do
            conn:Disconnect()
        end
        VisualityData.AdminCheck.Connections = {}
        local playerAddedConn = Players.PlayerAdded:Connect(function(player)
            task.wait(0.5)
            if Settings.AdminCheck.Enabled and isStaff(player) then
                LocalPlayer:Kick("Admin detected: " .. player.Name .. "\nSecurity violation")
            end
        end)
        table.insert(VisualityData.AdminCheck.Connections, playerAddedConn)
        task.spawn(function()
            local found = checkAdmins()
            if found then
                Settings.AdminCheck.Enabled = false
            end
        end)
    else
        for _, conn in ipairs(VisualityData.AdminCheck.Connections) do
            conn:Disconnect()
        end
        VisualityData.AdminCheck.Connections = {}
    end
end

