function GetChar(p) return p and p.Character end
function GetRoot(p)
    local c = GetChar(p)
    return c and (c:FindFirstChild("HumanoidRootPart") or c:FindFirstChild("Torso"))
end
function GetHum(p)
    local c = GetChar(p)
    return c and c:FindFirstChildOfClass("Humanoid")
end
function IsAlive(p)
    local h = GetHum(p)
    return h and h.Health > 0
end
function IsDowned(p)
    local c = GetChar(p)
    if not c then return false end
    local h = GetHum(p)
    if h and h.Health <= 15 then return true end
    local s = c:FindFirstChild("CharStats")
    if s then
        local d = s:FindFirstChild("Downed")
        if d and typeof(d.Value) == "boolean" then return d.Value end
    end
    return false
end
function HasFF(p)
    local c = GetChar(p)
    return c and c:FindFirstChildOfClass("ForceField") ~= nil
end
function IsTeam(p) return p.Team == LocalPlayer.Team end
function IsVisible(part)
    if not part then return false end
    local origin = Camera.CFrame.Position
    local rp = RaycastParams.new()
    rp.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    rp.FilterType = Enum.RaycastFilterType.Blacklist
    local r = workspace:Raycast(origin, part.Position - origin, rp)
    if r then return r.Instance:IsDescendantOf(part.Parent) end
    return true
end

function GetClosestTarget(targetPart, wallCheck, teamCheck, checkDowned, fovEnabled, fovRadius)
    if Settings.Wallbang.Enabled then wallCheck = false end
    local closest, shortest = nil, math.huge
    local center = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr == LocalPlayer or IsFriendly(plr) then continue end
        if teamCheck and IsTeam(plr) then continue end
        if not IsAlive(plr) then continue end
        if checkDowned and IsDowned(plr) then continue end
        if HasFF(plr) then continue end
        local c = GetChar(plr)
        local part = c and c:FindFirstChild(targetPart)
        if not part then continue end
        if wallCheck and not IsVisible(part) then continue end
        if fovEnabled then
            local sp, onSc = Camera:WorldToViewportPoint(part.Position)
            if not onSc then continue end
            local d2D = (Vector2.new(sp.X, sp.Y) - center).Magnitude
            if d2D > (fovRadius or 80) then continue end
            if d2D < shortest then closest = plr; shortest = d2D end
        else
            local dist = (Camera.CFrame.Position - part.Position).Magnitude
            if dist < shortest then closest = plr; shortest = dist end
        end
    end
    return closest
end

